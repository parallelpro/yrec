 $CONTROL  

 DESCRIP(1) = "model5.1 test suite. Core helium burning, diffusion, no rotation"
 DESCRIP(2) = "Gray Atm OPAL06+SCV EOS GN93" ! Second line label for output (optional)
 
 ISETMIX=0 ! 0 = do not adjust 1 = use specified mixture (AMIX below) 2 = custom mixture (see parmin.f for variables)
 ISETISO = 0! 0 = do not adjust 1 = use specified mixture (AISO below) 2 = custom mixture (see parmin.f for variables)

 LCALS = .FALSE. ! Toggle to auto-calibrate solar Y and alpha to match the solar R and L at the age of the Sun. Does not enforce correct Z/X for mixture.
 LCALSOLZX = .TRUE.
 CALSOLZX = 0.02292d0 
 TOLL = 3.0D-6 ! Tolerance target for L in the calibration routines.
 TOLR = 3.0D-6 ! Tolerance target for R in the calibration routines.
 CALSOLAGE = 4.568D9 ! Tolerance solar age in the calibration routines.
  
 NUMRUN = 2 ! Each YREC run can rescale a model, evolve a model, or do both (pre-MS only). This indicates the number of such steps requested.

 KINDRN(1) = 2 ! 1 = evolve 2= rescale (zero timestep,MS or CHeB); 3 = rescale and evolve (pre-MS, where there is no zero timestep solution)
 LFIRST(1) = .TRUE. ! T = use stored starting model F = use result of prior run
 CMIXLA(1) = 1.68
 RSCLX(1) = 0.703 ! If positive, rescale to this hydrogen.
 RSCLZ(1) = 0.019 ! If positive, rescale to this metallicity.
 NMODLS(1) = 10 ! Stop after this number of models. An initial rescaling with 2 models is recommended, followed by an evolve run

 KINDRN(2) = 1
 LFIRST(2) = .FALSE.
 NMODLS(2) = 1000000
 XENV0A(2) = 0.703 ! Envelope abundance label
 ZENV0A(2) = 0.019
 CMIXLA(2) = 1.68
 END_YCEN(2) = 0.0004 ! Run stops if NMODLS(I) is reached or this central helium is reached (TAHB)	


  
 LRWSH = .FALSE. ! If T, the short file retains only the details from the last model. This minimizes output file size.
  
  
 LALEX06 = .TRUE. ! If T, use Ferguson+2005 molecular opacities (recommended)
 FALEX06 = "{YREC_INPUT}/opacity/molecular/alex06/alexmol06gs98.tab" ! Molecular opacity table path  
 
   
 LOPAL95 = .TRUE. ! If T, use atomic opacities in the OP/OPAL format (recommended).
 ZOPAL951 = 0.019 ! Generate a surface mixture table with this Z. Speeds up models without diffusion.
 FLIV95 = "{YREC_INPUT}/opacity/atomic/legacy/opal95/GN93hz" ! Atomic opacity table path
 
 LPUREZ = .TRUE. 
 FPUREZ = "{YREC_INPUT}/opacity/atomic/lanl/PURECO.DBGLAOL" ! Pure Y/Z  opacity table path
  
 FFIRST = "{YREC_START}/zahb/100mSOLpreZAHB.last"
 FLAST = "{YREC_OUTPUT}/Test_m1p0feh+0p0_GN93_TAHB.mod" ! The latest converged model (.mod format) is stored here.
 FSHORT = "{YREC_OUTPUT}/Test_m1p0feh+0p0_GN93_TAHB.short" ! Details about the numerics of the model run are stored here.
 FSCOMP = "{YREC_OUTPUT}/Test_m1p0feh+0p0_GN93_TAHB.excomp" ! No longer used (light elements vs. time, now included in track file)
 FOPALE06 = "{YREC_INPUT}/eos/opal2006/EOSOPAL06Z0.019000000" ! OPAL 2006 EoS table path.
 FcondOpacP = "{YREC_INPUT}/opacity/conductive/potekhin/condall06.d" ! Conductive opacity table path.
 FATM = "{YREC_INPUT}/atmos/kurucz/atmk1990p00.tab" ! Model atmosphere look-up table for Kurucz and Kurucz/Castelli.
 FALLARD = "{YREC_INPUT}/atmos/allard/Nextgen2.all" ! Allard model atmosphere look-up table (solar Z only).
 FSCVH = "{YREC_INPUT}/eos/scv/h_tab_i.dat" ! SCZ EoS table for X
 FSCVHE = "{YREC_INPUT}/eos/scv/he_tab_i.dat" ! SCZ EoS table for Y
 FSCVZ = "{YREC_INPUT}/eos/scv/z_tab_i.dat" ! SCZ EoS table for Z (generated from YREC EoS, needed for consistency)
 FFERMI = "{YREC_INPUT}/eos/yale/FERMI.TAB" ! Fermi integral tables for partial degeracy
   
 $END  
