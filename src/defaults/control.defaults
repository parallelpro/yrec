! control.defaults -- every &control variable with its default.
! GENERATED by tools/gen_inlist.py from
! defaults/controls_registry.tsv (edit that, then regenerate).
! The defaults are the reader's: set_legacy_defaults, else the
! controls_buffer initializer.

&control

      ! Per run: the mixing-length parameter alpha (the solar calibration rewrites the later runs' entries)
      ! (legacy name: cmixla)
      mixing_length_alpha = 0

      ! Solar calibration: the target age of the Sun (yr)
      ! (legacy name: calsolage)
      target_solar_age = 4.57d9

      ! Solar calibration: the target surface Z/X (with calibrate_solar_zx)
      ! (legacy name: calsolzx)
      target_solar_zx = 0.02292d0

      ! Per-run description strings echoed in output headers
      ! (legacy name: descrip)
      run_description = ''

      ! Stop the run card at this age (yr); 0 = no age limit
      ! (legacy name: endage)
      max_age = 0.0d0

      ! LAOL 1989 opacity table
      ! (legacy name: flaol)
      laol_opacity_table_file = ''

      ! Pure-Z opacity table (metal diffusion support)
      ! (legacy name: fpurez)
      pure_z_opacity_table_file = ''

      ! LAOL 1989 opacity table, second Z
      ! (legacy name: flaol2)
      laol_opacity_table2_file = ''

      ! OPAL 1992 opacity table, second Z
      ! (legacy name: fopal2)
      opal92_opacity_table2_file = ''

      ! Path for the final model (.mod) written every model; reloadable
      ! (legacy name: flast)
      last_model_file = '{YREC_OUTPUT}/final.mod'

      ! Starting model read when read_first_model is set for a run
      ! (legacy name: ffirst)
      first_model_file = ''

      ! Fermi-Dirac integral table (Yale/Prather degenerate-electron EOS)
      ! (legacy name: ffermi)
      fermi_table_file = ''

      ! Opened on the dynamics unit (formatted, STATUS=OLD)
      ! (legacy name: fdyn)
      dynamics_file = ''

      ! OPAL 1992 opacity table (use_opal92_tables)
      ! (legacy name: flldat)
      ! (also accepted: ll_data_file)
      opal92_opacity_table_file = ''

      ! Accepted and ignored: no surface-composition file is written any more (the light elements are history columns); kept so that decks setting it still read
      ! (legacy name: fscomp)
      surface_composition_file = ''

      ! Kurucz 1990 low-temperature opacity table (use_kurucz90_tables)
      ! (legacy name: fkur)
      ! (also accepted: kurucz_atm_table_file)
      kurucz_opacity_table_file = ''

      ! MHD EOS table 1 of 8: the first ZAMS-type composition
      ! (legacy name: fmhd1)
      mhd_table_file_1 = ''

      ! MHD EOS table 2 of 8: the second ZAMS-type composition
      ! (legacy name: fmhd2)
      mhd_table_file_2 = ''

      ! MHD EOS table 3 of 8: the third ZAMS-type composition
      ! (legacy name: fmhd3)
      mhd_table_file_3 = ''

      ! MHD EOS table 4 of 8: the first centre-type composition
      ! (legacy name: fmhd4)
      mhd_table_file_4 = ''

      ! MHD EOS table 5 of 8: the second centre-type composition
      ! (legacy name: fmhd5)
      mhd_table_file_5 = ''

      ! MHD EOS table 6 of 8: the third centre-type composition
      ! (legacy name: fmhd6)
      mhd_table_file_6 = ''

      ! MHD EOS table 7 of 8: the fourth centre-type composition
      ! (legacy name: fmhd7)
      mhd_table_file_7 = ''

      ! MHD EOS table 8 of 8: the fifth centre-type composition
      ! (legacy name: fmhd8)
      mhd_table_file_8 = ''

      ! Isochrone output file
      ! (legacy name: fiso)
      isochrone_file = ''

      ! Kurucz (atm_choice 3 and 4) or Castelli/Kurucz (5) surface-pressure table
      ! (legacy name: fatm)
      atm_table_file = ''

      ! Kurucz 1990 low-temperature opacity table, second Z
      ! (legacy name: fkur2)
      ! (also accepted: kurucz_castelli_atm_table_file)
      kurucz_opacity_table2_file = ''

      ! Allard NextGen model-atmosphere table
      ! (legacy name: fallard)
      allard_atm_table_file = ''

      ! Saumon-Chabrier-Van Horn EOS: hydrogen table
      ! (legacy name: fscvh)
      scv_h_table_file = ''

      ! SCV EOS: helium table
      ! (legacy name: fscvhe)
      scv_he_table_file = ''

      ! SCV EOS: metals table
      ! (legacy name: fscvz)
      scv_z_table_file = ''

      ! OPAL 1995 EOS table (use_opal95_eos)
      ! (legacy name: fopale)
      ! (also accepted: opal_eos_table_file)
      opal95_eos_table_file = ''

      ! OPAL 1995-format opacity table (use_opal95_tables)
      ! (legacy name: fliv95)
      opal95_opacity_table_file = ''

      ! Monte Carlo runs: the file for each run's summary
      ! (legacy name: fmonte1)
      monte_carlo_file1_path = ''

      ! Monte Carlo runs: the file for each run's final model
      ! (legacy name: fmonte2)
      monte_carlo_file2_path = ''

      ! Per-run kind card: 1 = evolve, 2 = rescale (zero timestep, MS/CHeB), 3 = rescale and evolve (pre-MS)
      ! (legacy name: kindrn)
      run_kind = 1

      ! DEFAULT IS .TRUE. for every card (read_controls DATA lfirst/50*.true./): an omitted first_call_flag(n) restarts card n from first_model_file, so continuation cards must set it .false. explicitly.
      ! (legacy name: lfirst)
      first_call_flag = .true.

      ! Model number given to the first converged model after a fresh start-model load (first_call_flag card). <= 0 keeps the counter stored in the model file (restart continuation, the pre-2026 behavior).
      set_initial_model_number = 1

      ! On a rescaling run with rescale_core_z, rescale_z_mix1 and rescale_z_mix2 positive: Z = rescale_core_z inside the mass fraction rescale_z_mix1, then linear to the surface Z at rescale_z_mix2
      ! (legacy name: lzramp)
      use_z_ramp = .false.

      ! Star calibration: match the target Teff (target_teff) instead of the target radius (target_radius_rsun)
      ! (legacy name: lteff)
      specify_teff_flag = .false.

      ! Calibrate the mixing length and Y so that the star reaches target_luminosity_lsun at the target radius or Teff
      ! (legacy name: lcalst)
      calibrate_star_flag = .false.

      ! Use the pure C and N opacity tables (pure_z_opacity_table_file) for metal-enriched mixtures
      ! (legacy name: lpurez)
      use_pure_z_table = .false.

      ! Write an isochrone record every model to isochrone_file
      ! (legacy name: liso)
      isochrone_output_active = .false.

      ! Rewind the run log every model, so it holds only the latest model's solver diagnostics
      ! (legacy name: lrwsh)
      rewind_short_file = .false.

      ! Per run: move the outer fitting point to the fractional envelope mass senv0_array
      ! (legacy name: lsenv0a)
      has_senv0_array = .false.

      ! Calibrate Y and the mixing length so that the model matches the solar L and R at target_solar_age
      ! (legacy name: lcals)
      calibrate_solar_model = .false.

      ! Solar calibration: also calibrate Z to match target_solar_zx (within zx_tolerance)
      ! (legacy name: lcalsolzx)
      calibrate_solar_zx = .false.

      ! Use the LAOL 1989 opacity tables (laol_opacity_table_file)
      ! (legacy name: llaol89)
      use_laol89_tables = .false.

      ! Use the OPAL 1992 opacity tables (opal92_opacity_table_file)
      ! (legacy name: lopal92)
      use_opal92_tables = .false.

      ! Use the OPAL 1995 / OP atomic opacity tables (opal95_opacity_table_file)
      ! (legacy name: lopal95)
      use_opal95_tables = .false.

      ! Use the Kurucz 1990 low-temperature opacity tables
      ! (legacy name: lkur90)
      use_kurucz90_tables = .false.

      ! Use the Alexander & Ferguson 1994 low-temperature opacity tables (alex95_table_z_list)
      ! (legacy name: lalex95)
      use_alex95_tables = .false.

      ! Envelope profile print count (values <= 0 become 9999 = off)
      ! (legacy name: npenv)
      envelope_print_points = 0

      ! The number of runs (kind cards): each rescales a model, evolves it, or both
      ! (legacy name: numrun)
      num_runs = 1

      ! Per run: the number of models to compute (the run stops earlier if a stop condition is met)
      ! (legacy name: nmodls)
      max_model_number = 0

      ! The seven Alexander & Ferguson 1994 low-temperature opacity table files
      ! (legacy name: opecalex)
      ! (also accepted: alex95_table_z_list)
      alex95_opacity_table_files = ''

      ! Per-run target mass (Msun) for rescale runs
      ! (legacy name: rsclm)
      rescale_mass = 0.0d0

      ! Per-run target hydrogen fraction for rescale runs
      ! (legacy name: rsclx)
      rescale_x = 0.0d0

      ! Per-run target metallicity for rescale runs
      ! (legacy name: rsclz)
      rescale_z = 0.0d0

      ! Per-run rescale: core mass bound
      ! (legacy name: rsclcm)
      rescale_core_mass = 0.0d0

      ! rscale/setcal: core-Z rescale target
      ! (legacy name: rsclzc)
      rescale_core_z = -1.0d0

      ! rscale/setcal: Z-mix rescale parameter 1
      ! (legacy name: rsclzm1)
      rescale_z_mix1 = -1.0d0

      ! rscale/setcal: Z-mix rescale parameter 2
      ! (legacy name: rsclzm2)
      rescale_z_mix2 = -1.0d0

      ! Per run: if positive, a fixed timestep (yr) for every model of the run, overriding the timestep limits
      ! (legacy name: setdt)
      timestep_override = 0.0d0

      ! Per run: log10 of the fractional envelope mass of the outer fitting point (with has_senv0_array)
      ! (legacy name: senv0a)
      senv0_array = 1.26d-4

      ! Star calibration: the target Teff (K), with specify_teff_flag
      ! (legacy name: steff)
      target_teff = 0

      ! Star calibration: the target radius (Rsun)
      ! (legacy name: sr)
      target_radius_rsun = 0

      ! Solar calibration: tolerance on |log R/Rsun|
      ! (legacy name: tolr)
      radius_tolerance = 1.0d-4

      ! Solar calibration: tolerance on |log L/Lsun|
      ! (legacy name: toll)
      luminosity_tolerance = 1.0d-5

      ! Solar calibration: the tolerance on log10(Z/X)
      ! (legacy name: tolz)
      zx_tolerance = 1.0d-3

      ! Starting hydrogen mass fraction X, per run card
      ! (legacy name: xenv0a)
      initial_x_array = 0

      ! Star calibration: the target luminosity (Lsun)
      ! (legacy name: xls)
      target_luminosity_lsun = 0

      ! Star calibration: the tolerance on L/Lsun at the target radius or Teff
      ! (legacy name: xlstol)
      target_star_luminosity_tolerance = 0

      ! Starting metal mass fraction Z, per run card
      ! (legacy name: zenv0a)
      initial_z_array = 0

      ! Metallicity of the first LAOL89 opacity table
      ! (legacy name: zlaol1)
      laol_table_z1 = 0

      ! Metallicity of the second LAOL89 opacity table (two-Z interpolation)
      ! (legacy name: zlaol2)
      laol_table_z2 = 0

      ! Metallicity of the first OPAL92 opacity table
      ! (legacy name: zopal1)
      opal_table_z1 = 0

      ! Z of the second OPAL 1992 opacity table
      ! (legacy name: zopal2)
      opal_table_z2 = 0

      ! Z of the surface-mixture OPAL 1995 / OP table generated at the start
      ! (legacy name: zopal951)
      opal95_single_table_z = 0

      ! Inert: read and used nowhere (the OPAL 1995 tables take one Z, opal95_single_table_z); the controls read warns when it is set
      ! (legacy name: zopal952)
      opal95_z2 = 0

      ! Z of the Alexander & Ferguson 1994 low-temperature table
      ! (legacy name: zalex1)
      alex_table_z1 = 0

      ! Inert: read and used nowhere (the Alexander tables take one Z, alex_table_z1); the controls read warns when it is set
      ! (legacy name: zalex2)
      alex_z2 = 0

      ! Z of the first Kurucz 1990 opacity table
      ! (legacy name: zkur1)
      kurucz_table_z1 = 0

      ! Z of the second Kurucz 1990 opacity table
      ! (legacy name: zkur2)
      kurucz_table_z2 = 0

      ! OPAL 2001 EOS table (use_opal2001_eos)
      ! (legacy name: fopale01)
      opal01_eos_table_file = ''

      ! Potekhin conductive opacity table
      ! (legacy name: fcondopacp)
      conductive_opacity_table_file = ''

      ! OPAL 2006 EOS table (use_opal2006_eos)
      ! (legacy name: fopale06)
      opal06_eos_table_file = ''

      ! Ferguson/Alexander 2006 low-T opacity tables
      ! (legacy name: falex06)
      alex06_opacity_table_file = ''

      ! Use the Ferguson et al. 2005 molecular opacity tables (alex06_opacity_table_file)
      ! (legacy name: lalex06)
      use_alex06_tables = .false.

      ! Per run: stop when the central deuterium mass fraction falls below this (0: off)
      ! (legacy name: end_dcen)
      central_deuterium_stop = 0.0d0

      ! Per run: stop when the central hydrogen mass fraction falls below this (0: off)
      ! (legacy name: end_xcen)
      central_hydrogen_stop = 0.0d0

      ! Per run: stop when the central helium mass fraction falls below this (0: off)
      ! (legacy name: end_ycen)
      central_helium_stop = 0.0d0

      ! 1: set the starting model's C, N and O fractions of Z from cno_mixture_name
      ! (legacy name: isetmix)
      mixture_change_mode = 0

      ! 1: set the starting model's CNO isotope ratios and light-element abundances from isotope_mixture_name
      ! (legacy name: isetiso)
      isotope_change_mode = 0

      ! Heavy-element mixture selector (GS98/CUS/...) applied to the start model
      ! (legacy name: amix)
      cno_mixture_name = 'GS98'

      ! Isotope-ratio set selector (L21 default or CUS custom)
      ! (legacy name: aiso)
      isotope_mixture_name = 'L21'

      ! Carbon fraction of the CNO metals for cno_mixture_name 'CUS' (with cno_mixture_mode = 1)
      ! (legacy name: frac_c)
      target_carbon_cno_fraction = 0.172148d0

      ! Nitrogen fraction of the CNO metals for cno_mixture_name 'CUS'
      ! (legacy name: frac_n)
      target_nitrogen_cno_fraction = 0.050426d0

      ! Oxygen fraction of the CNO metals for cno_mixture_name 'CUS'
      ! (legacy name: frac_o)
      target_oxygen_cno_fraction = 0.468195d0

      ! C12/C13 number ratio of the starting model for isotope_mixture_name 'CUS' (with isotope_mixture_mode = 1)
      ! (legacy name: r12_13)
      c12_to_c13_ratio = 88.27d0

      ! N14/N15 number ratio for isotope_mixture_name 'CUS'
      ! (legacy name: r14_15)
      n14_to_n15_ratio = 411.9d0

      ! O16/O17 number ratio for isotope_mixture_name 'CUS'
      ! (legacy name: r16_17)
      o16_to_o17_ratio = 471.4d0

      ! O16/O18 number ratio for isotope_mixture_name 'CUS'
      ! (legacy name: r16_18)
      o16_to_o18_ratio = 2693.0d0

      ! Z/X for cno_mixture_name 'CUS' (inert: stored and used nowhere; the starting model keeps its Z)
      ! (legacy name: zxmix)
      target_metal_fraction = 0.02292d0

      ! Initial H2 mass fraction for isotope_mixture_name 'CUS'
      ! (legacy name: xh2_ini)
      initial_h2_fraction = 2.781d-5

      ! Initial He3 mass fraction for isotope_mixture_name 'CUS'
      ! (legacy name: xhe3_ini)
      initial_he3_fraction = 3.461d-5

      ! Initial Li6 mass fraction for isotope_mixture_name 'CUS'
      ! (legacy name: xli6_ini)
      initial_li6_fraction = 7.187d-10

      ! Initial Li7 mass fraction for isotope_mixture_name 'CUS'
      ! (legacy name: xli7_ini)
      initial_li7_fraction = 1.025d-8

      ! Initial Be9 mass fraction for isotope_mixture_name 'CUS'
      ! (legacy name: xbe9_ini)
      initial_be9_fraction = 1.595d-10

      ! Initial B10 mass fraction for isotope_mixture_name 'CUS'
      ! (legacy name: xb10_ini)
      initial_b10_fraction = 1.002d-9

      ! Initial B11 mass fraction for isotope_mixture_name 'CUS'
      ! (legacy name: xb11_ini)
      initial_b11_fraction = 4.405d-9

      ! Write the interior-only GYRE file every this many models (0 = off)
      pulse_gyre_interval = 0

      ! File listing the history columns (one name per line, ! comments); blank: the default selection of defaults/history_columns.list
      history_columns_file = ' '

      ! File listing the profile columns; blank: the default selection of defaults/profile_columns.list
      profile_columns_file = ' '

      ! Verbatim copy of the input namelist file(s), written at startup as run provenance; blank (the default): inlist_used in the output directory, the run log's
      inlist_used_file = ' '

      ! Per kind card: stop the card when log(L/Lsun) exceeds this (1d99 = off)
      log_L_upper_limit = 1.0d99

      ! Per kind card: stop the card when log(L/Lsun) drops below this (-1d99 = off)
      log_L_lower_limit = -1.0d99

      ! Per kind card: stop the card when Teff [K] exceeds this (1d99 = off)
      Teff_upper_limit = 1.0d99

      ! Per kind card: stop the card when Teff [K] drops below this (-1d99 = off)
      Teff_lower_limit = -1.0d99

      ! Per kind card: stop the card when surface log g [cgs] exceeds this (1d99 = off)
      log_g_upper_limit = 1.0d99

      ! Per kind card: stop the card when surface log g [cgs] drops below this (-1d99 = off)
      log_g_lower_limit = -1.0d99

      ! Per kind card: stop the card when nu_max [uHz] (scaling relation) exceeds this (1d99 = off)
      nu_max_upper_limit = 1.0d99

      ! Per kind card: stop the card when nu_max [uHz] (scaling relation) drops below this (-1d99 = off)
      nu_max_lower_limit = -1.0d99

/

! Unused legacy controls (accepted by the legacy reader only,
! referenced nowhere in the code; dropped from the new format):
!   fstch
