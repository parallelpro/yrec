      ! former common/ovrtrn/'s two config members: NAMELIST /physics/ values selecting the newer convective-turnover-timescale calculation and whether to run the full envelope i
      ! (legacy name: lnewtcz)
      use_new_turnover_timescale = .false.   ! (implicit)

      ! (legacy name: lcalcenv)
      calc_envelope_flag = .false.   ! (implicit)

      ! MESA mode: history file name (written to the output directory)
      star_history_name = 'history.data'

      ! MESA mode: write profile{N}.data every N converged models (0 = off); the history profile_number column maps models to profiles
      profile_interval = 50

      ! MESA mode: pulse file format written every pulse_gyre_interval models: GYRE or FGONG
      pulse_format = 'GYRE'

