      ! (legacy name: sbe93)
      be9_palpha_rate_scale = 0.0   ! (implicit)

      ! (legacy name: lnewnuc)
      use_new_nuclear_rates = .false.

      ! former common/spots/: all 3 members are NAMELIST /physics/ values, same namelist-can't-rename treatment as above -- core/parmin.f90 keeps its local spotf/spotx/lsdepth an
      ! (legacy name: spotf)
      spot_filling_factor = 0.0   ! (implicit)

      ! (legacy name: spotx)
