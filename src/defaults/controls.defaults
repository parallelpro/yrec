      ! (legacy name: sli6)
      li6_rate_scale = 0.0   ! (implicit)

      ! former common/burnscs/: light-element cross-section scale factors. core/parmin.f90's own local names (sli6 etc) are themselves NAMELIST /physics/ members (see that file's
      ! (legacy name: sli7)
      li7_rate_scale = 0.0   ! (implicit)

