! star_job.defaults -- every &star_job control with its default.
! GENERATED by tools/gen_inlist.py from
! defaults/controls_registry.tsv (edit that, then regenerate).
! Defaults marked (implicit) are static zero/false/'' --
! no explicit assignment exists; pinned by -finit-local-zero.

&star_job

      ! (legacy name: cmixla)
      mixing_length_alpha = 0.0   ! (implicit)

      ! (legacy name: calsolage)
      target_solar_age = 0.0   ! (implicit)

      ! (legacy name: calsolzx)
      target_solar_zx = 0.0   ! (implicit)

      ! Per-run description strings echoed in output headers
      ! (legacy name: descrip)
      run_description = ''   ! (implicit)

      ! former common/sett/: target_end_age/timestep_override/ central_deuterium_stop/central_hydrogen_stop/central_helium_stop are NAMELIST /physics/ values (core/parmin.f90's e
      ! (legacy name: endage)
      max_age = 0.0   ! (implicit)

      ! LAOL 1989 opacity table
      ! (legacy name: flaol)
      laol_opacity_table_file = ''   ! (implicit)

      ! Pure-Z opacity table (metal diffusion support)
      ! (legacy name: fpurez)
      pure_z_opacity_table_file = ''   ! (implicit)

      ! LAOL 1989 opacity table, second Z
      ! (legacy name: flaol2)
      laol_opacity_table2_file = ''   ! (implicit)

      ! OPAL 1992 opacity table, second Z
      ! (legacy name: fopal2)
      opal92_opacity_table2_file = ''   ! (implicit)

      ! Path for the final model (.mod) written every model; reloadable
      ! (legacy name: flast)
      last_model_file = '{YREC_OUTPUT}/final.mod'

      ! Starting model read when read_first_model is set for a run
      ! (legacy name: ffirst)
      first_model_file = ''   ! (implicit)

      ! Fermi-Dirac integral table (Yale/Prather degenerate-electron EOS)
      ! (legacy name: ffermi)
      fermi_table_file = ''   ! (implicit)

      ! Debug output stream
      ! (legacy name: fdebug)
      debug_output_file = ''   ! (implicit)

      ! Model summary (.short) output path
      ! (legacy name: fshort)
      short_output_file = ''   ! (implicit)

      ! Opened on the dynamics unit (formatted, STATUS=OLD)
      ! (legacy name: fdyn)
      dynamics_file = ''   ! (implicit)

      ! Livermore opacity auxiliary data file
      ! (legacy name: flldat)
      ll_data_file = ''   ! (implicit)

      ! Surface-composition output file
      ! (legacy name: fscomp)
      surface_composition_file = ''   ! (implicit)

      ! Kurucz model-atmosphere boundary-condition table
      ! (legacy name: fkur)
      kurucz_atm_table_file = ''   ! (implicit)

      ! MHD EOS table 1 of 8
      ! (legacy name: fmhd1)
      mhd_table_file_1 = ''   ! (implicit)

      ! MHD EOS table 2 of 8
      ! (legacy name: fmhd2)
      mhd_table_file_2 = ''   ! (implicit)

      ! MHD EOS table 3 of 8
      ! (legacy name: fmhd3)
      mhd_table_file_3 = ''   ! (implicit)

      ! MHD EOS table 4 of 8
      ! (legacy name: fmhd4)
      mhd_table_file_4 = ''   ! (implicit)

      ! MHD EOS table 5 of 8
      ! (legacy name: fmhd5)
      mhd_table_file_5 = ''   ! (implicit)

      ! MHD EOS table 6 of 8
      ! (legacy name: fmhd6)
      mhd_table_file_6 = ''   ! (implicit)

      ! MHD EOS table 7 of 8
      ! (legacy name: fmhd7)
      mhd_table_file_7 = ''   ! (implicit)

      ! MHD EOS table 8 of 8
      ! (legacy name: fmhd8)
      mhd_table_file_8 = ''   ! (implicit)

      ! Isochrone output file
      ! (legacy name: fiso)
      isochrone_file = ''   ! (implicit)

      ! Atmosphere P(T) boundary-condition table
      ! (legacy name: fatm)
      atm_table_file = ''   ! (implicit)

      ! Castelli-Kurucz model-atmosphere table
      ! (legacy name: fkur2)
      kurucz_castelli_atm_table_file = ''   ! (implicit)

      ! Allard NextGen model-atmosphere table
      ! (legacy name: fallard)
      allard_atm_table_file = ''   ! (implicit)

      ! Saumon-Chabrier-Van Horn EOS: hydrogen table
      ! (legacy name: fscvh)
      scv_h_table_file = ''   ! (implicit)

      ! SCV EOS: helium table
      ! (legacy name: fscvhe)
      scv_he_table_file = ''   ! (implicit)

      ! SCV EOS: metals table
      ! (legacy name: fscvz)
      scv_z_table_file = ''   ! (implicit)

      ! OPAL 1995/2001 EOS table
      ! (legacy name: fopale)
      opal_eos_table_file = ''   ! (implicit)

      ! OPAL/Livermore 1995 opacity tables
      ! (legacy name: fliv95)
      opal95_opacity_table_file = ''   ! (implicit)

      ! former common/iomonte/: monte_carlo_file1_path/monte_carlo_file2_path (originally fmonte1/fmonte2) are NAMELIST values with different canonical spellings, kept local in c
      ! (legacy name: fmonte1)
      monte_carlo_file1_path = ''   ! (implicit)

      ! former common/iomonte/: monte_carlo_file1_path/monte_carlo_file2_path (originally fmonte1/fmonte2) are NAMELIST values with different canonical spellings, kept local in c
      ! (legacy name: fmonte2)
      monte_carlo_file2_path = ''   ! (implicit)

      ! Per-run kind card: 1 = evolve, 2 = rescale (zero timestep, MS/CHeB), 3 = rescale and evolve (pre-MS)
      ! (legacy name: kindrn)
      run_kind = 0   ! (implicit)

      ! Enable the debug output stream
      ! (legacy name: ldebug)
      write_debug_output = .false.   ! (implicit)

      ! crrect: print solver correction diagnostics
      ! (legacy name: lcorr)
      write_correction_output = .false.   ! (implicit)

      ! (legacy name: lfirst)
      first_call_flag = .false.   ! (implicit)

      ! former common/pulse/: pulsation_output_active/pulsation_file_version (originally lpulse/ipver) are NAMELIST values with different canonical spellings, kept local in core/
      ! (legacy name: lpulse)
      pulsation_output_active = .false.

      ! (legacy name: lzramp)
      use_z_ramp = .false.

      ! (legacy name: lteff)
      specify_teff_flag = .false.   ! (implicit)

      ! (legacy name: lcalst)
      calibrate_star_flag = .false.   ! (implicit)

      ! (legacy name: lpurez)
      use_pure_z_table = .false.

      ! former common/chrone/: rewind_short_file/isochrone_output_active (originally lrwsh/liso) are NAMELIST values with different canonical spellings, kept local in core/parmin
      ! (legacy name: liso)
      isochrone_output_active = .false.   ! (implicit)

      ! former common/chrone/: rewind_short_file/isochrone_output_active (originally lrwsh/liso) are NAMELIST values with different canonical spellings, kept local in core/parmin
      ! (legacy name: lrwsh)
      rewind_short_file = .false.   ! (implicit)

      ! (legacy name: lsenv0a)
      has_senv0_array = .false.   ! (implicit)

      ! (legacy name: lcals)
      calibrate_solar_model = .false.   ! (implicit)

      ! (legacy name: lcalsolzx)
      calibrate_solar_zx = .false.   ! (implicit)

      ! (legacy name: llaol89)
      use_laol89_tables = .false.   ! (implicit)

      ! (legacy name: lopal92)
      use_opal92_tables = .false.   ! (implicit)

      ! (legacy name: lopal95)
      use_opal95_tables = .false.   ! (implicit)

      ! (legacy name: lkur90)
      use_kurucz90_tables = .false.   ! (implicit)

      ! (legacy name: lalex95)
      use_alex95_tables = .false.   ! (implicit)

      ! hpoint debug print every N models (9999 = off)
      ! (legacy name: npoint)
      debug_print_interval = 0   ! (implicit)

      ! Envelope profile print count (values <= 0 become 9999 = off)
      ! (legacy name: npenv)
      envelope_print_points = 0   ! (implicit)

      ! (legacy name: numrun)
      num_runs = 0   ! (implicit)

      ! (legacy name: nmodls)
      max_model_number = 0   ! (implicit)

      ! VERIFIED 2026: the seven Alexander-1995 low-T opacity table FILE PATHS (character(len=256)(7)), relayed to star%job%alex95_table_paths -- the old 'alex_z_value' guess was wrong.
      ! (legacy name: opecalex)
      alex95_table_z_list = 'OPACALEXANDER.X00',

      ! Per-run target mass (Msun) for rescale runs
      ! (legacy name: rsclm)
      rescale_mass = 0.0   ! (implicit)

      ! Per-run target hydrogen fraction for rescale runs
      ! (legacy name: rsclx)
      rescale_x = 0.0   ! (implicit)

      ! Per-run target metallicity for rescale runs
      ! (legacy name: rsclz)
      rescale_z = 0.0   ! (implicit)

      ! Per-run rescale: core mass bound
      ! (legacy name: rsclcm)
      rescale_core_mass = 0.0   ! (implicit)

      ! rscale/setcal: core-Z rescale target
      ! (legacy name: rsclzc)
      rescale_core_z = 0.0   ! (implicit)

      ! rscale/setcal: Z-mix rescale parameter 1
      ! (legacy name: rsclzm1)
      rescale_z_mix1 = 0.0   ! (implicit)

      ! rscale/setcal: Z-mix rescale parameter 2
      ! (legacy name: rsclzm2)
      rescale_z_mix2 = 0.0   ! (implicit)

      ! (legacy name: setdt)
      timestep_override = 0.0   ! (implicit)

      ! (legacy name: senv0a)
      senv0_array = 0.0   ! (implicit)

      ! (legacy name: steff)
      target_teff = 0.0   ! (implicit)

      ! (legacy name: sr)
      target_radius_rsun = 0.0   ! (implicit)

      ! former common/cals2/: luminosity_tolerance/radius_tolerance/ zx_tolerance/calibrate_solar_model/calibrate_solar_zx/ target_solar_zx/target_solar_age (originally toll/tolr
      ! (legacy name: tolr)
      radius_tolerance = 0.0   ! (implicit)

      ! former common/cals2/: luminosity_tolerance/radius_tolerance/ zx_tolerance/calibrate_solar_model/calibrate_solar_zx/ target_solar_zx/target_solar_age (originally toll/tolr
      ! (legacy name: toll)
      luminosity_tolerance = 0.0   ! (implicit)

      ! (legacy name: tolz)
      zx_tolerance = 0.0   ! (implicit)

      ! former common/newxym/: initial_x_array/initial_z_array/ mixing_length_array/has_senv0_array/senv0_array (originally xenv0a/ zenv0a/cmixla/lsenv0a/senv0a) are NAMELIST val
      ! (legacy name: xenv0a)
      initial_x_array = 0.0   ! (implicit)

      ! former common/calstar/: target_luminosity_lsun/ target_star_luminosity_tolerance/target_teff/target_radius_rsun/ specify_teff_flag/calibrate_star_flag (originally xls/xls
      ! (legacy name: xls)
      target_luminosity_lsun = 0.0   ! (implicit)

      ! (legacy name: xlstol)
      target_star_luminosity_tolerance = 0.0   ! (implicit)

      ! former common/newxym/: initial_x_array/initial_z_array/ mixing_length_array/has_senv0_array/senv0_array (originally xenv0a/ zenv0a/cmixla/lsenv0a/senv0a) are NAMELIST val
      ! (legacy name: zenv0a)
      initial_z_array = 0.0   ! (implicit)

      ! former common/newopac/: laol_table_z1/laol_table_z2/opal_table_z1/ opal_table_z2/opal95_single_table_z/alex_table_z1/kurucz_table_z1/ kurucz_table_z2/molecular_opacity_lo
      ! (legacy name: zlaol1)
      laol_table_z1 = 0.0   ! (implicit)

      ! former common/newopac/: laol_table_z1/laol_table_z2/opal_table_z1/ opal_table_z2/opal95_single_table_z/alex_table_z1/kurucz_table_z1/ kurucz_table_z2/molecular_opacity_lo
      ! (legacy name: zlaol2)
      laol_table_z2 = 0.0   ! (implicit)

      ! former common/newopac/: laol_table_z1/laol_table_z2/opal_table_z1/ opal_table_z2/opal95_single_table_z/alex_table_z1/kurucz_table_z1/ kurucz_table_z2/molecular_opacity_lo
      ! (legacy name: zopal1)
      opal_table_z1 = 0.0   ! (implicit)

      ! (legacy name: zopal2)
      opal_table_z2 = 0.0   ! (implicit)

      ! (legacy name: zopal951)
      opal95_single_table_z = 0.0   ! (implicit)

      ! Second Z of the OPAL95 opacity table pair
      ! (legacy name: zopal952)
      opal95_z2 = 0.0   ! (implicit)

      ! (legacy name: zalex1)
      alex_table_z1 = 0.0   ! (implicit)

      ! Second Z of the Alexander table pair
      ! (legacy name: zalex2)
      alex_z2 = 0.0   ! (implicit)

      ! (legacy name: zkur1)
      kurucz_table_z1 = 0.0   ! (implicit)

      ! (legacy name: zkur2)
      kurucz_table_z2 = 0.0   ! (implicit)

      ! OPAL 2001 EOS table
      ! (legacy name: fopale01)
      opal01_eos_table_file = ''   ! (implicit)

      ! Potekhin conductive opacity table
      ! (legacy name: fcondopacp)
      conductive_opacity_table_file = ''   ! (implicit)

      ! OPAL 2006 EOS table
      ! (legacy name: fopale06)
      opal06_eos_table_file = ''   ! (implicit)

      ! Ferguson/Alexander 2006 low-T opacity tables
      ! (legacy name: falex06)
      alex06_opacity_table_file = ''   ! (implicit)

      ! (legacy name: lalex06)
      use_alex06_tables = .false.   ! (implicit)

      ! (legacy name: end_dcen)
      central_deuterium_stop = 0.0   ! (implicit)

      ! (legacy name: end_xcen)
      central_hydrogen_stop = 0.0   ! (implicit)

      ! (legacy name: end_ycen)
      central_helium_stop = 0.0   ! (implicit)

      ! former common/newmx/: mixture_change_mode/isotope_change_mode/ target_carbon_cno_fraction/target_nitrogen_cno_fraction/ target_oxygen_cno_fraction/c12_to_c13_ratio/n14_to
      ! (legacy name: isetmix)
      mixture_change_mode = 0   ! (implicit)

      ! former common/newmx/: mixture_change_mode/isotope_change_mode/ target_carbon_cno_fraction/target_nitrogen_cno_fraction/ target_oxygen_cno_fraction/c12_to_c13_ratio/n14_to
      ! (legacy name: isetiso)
      isotope_change_mode = 0   ! (implicit)

      ! Heavy-element mixture selector (GS98/CUS/...) applied to the start model
      ! (legacy name: amix)
      cno_mixture_name = ''   ! (implicit)

      ! Isotope-ratio set selector (L21 default or CUS custom)
      ! (legacy name: aiso)
      isotope_mixture_name = ''   ! (implicit)

      ! (legacy name: frac_c)
      target_carbon_cno_fraction = 0.0   ! (implicit)

      ! (legacy name: frac_n)
      target_nitrogen_cno_fraction = 0.0   ! (implicit)

      ! (legacy name: frac_o)
      target_oxygen_cno_fraction = 0.0   ! (implicit)

      ! (legacy name: r12_13)
      c12_to_c13_ratio = 0.0   ! (implicit)

      ! (legacy name: r14_15)
      n14_to_n15_ratio = 0.0   ! (implicit)

      ! (legacy name: r16_17)
      o16_to_o17_ratio = 0.0   ! (implicit)

      ! (legacy name: r16_18)
      o16_to_o18_ratio = 0.0   ! (implicit)

      ! (legacy name: zxmix)
      target_metal_fraction = 0.0   ! (implicit)

      ! (legacy name: xh2_ini)
      initial_h2_fraction = 0.0   ! (implicit)

      ! (legacy name: xhe3_ini)
      initial_he3_fraction = 0.0   ! (implicit)

      ! (legacy name: xli6_ini)
      initial_li6_fraction = 0.0   ! (implicit)

      ! (legacy name: xli7_ini)
      initial_li7_fraction = 0.0   ! (implicit)

      ! (legacy name: xbe9_ini)
      initial_be9_fraction = 0.0   ! (implicit)

      ! (legacy name: xb10_ini)
      initial_b10_fraction = 0.0   ! (implicit)

      ! (legacy name: xb11_ini)
      initial_b11_fraction = 0.0   ! (implicit)

      ! former common/pulsegyre/: pulse_gyre_interval is a NAMELIST /control/ value spelled identically to its canonical name.
      pulse_gyre_interval = 0   ! (implicit)

      ! Output style: .true. = historical .track/.store streams; .false. = MESA-format output (.history now, profiles to follow). Default depends on inlist style.
      use_legacy_output = .true. legacy decks / .false. new-style inlists

      ! MESA mode: file listing the history columns to write (one name per line, ! comments); blank = all columns
      history_columns_file = '' (all columns)

      ! MESA mode: file listing the profile columns to write; blank = all columns
      profile_columns_file = '' (all columns)

/

