! physics.defaults -- every &physics variable with its default.
! GENERATED by tools/gen_inlist.py -- do not edit. A control's
! description and default are its declaration in io/controls_buffer.f90
! (the comment above it, its initializer); its names and group are its
! row in defaults/controls_registry.tsv. Edit those, then regenerate.

&physics

      ! Run log path; its directory part defines the output directory (legacy FSHORT)
      ! (legacy name: fshort)
      log_output_file = '{YREC_OUTPUT}/run.log'

      ! The atmosphere integration's smallest step (in log tau)
      ! (legacy name: atmmin)
      atm_step_min = 1.0d-1

      ! Atmosphere integration: the first step
      ! (legacy name: atmbeg)
      atm_step_begin = 1.0d-1

      ! Atmosphere integration: error tolerance
      ! (legacy name: atmerr)
      atm_error_tol = 3.0d-4

      ! The atmosphere integration's largest step (in log tau)
      ! (legacy name: atmmax)
      atm_step_max = 5.0d-1

      ! Atmosphere integration: the starting density (g/cm^3) at optical depth near zero; divided by 10 on each retry
      ! (legacy name: atmd0)
      atm_step_initial = 1.0d-10

      ! Element id whose abundance to override in the start model (with change_species_value)
      ! (legacy name: anewcp)
      change_species_name = '   '

      ! With rescale_species_active: 'ABS' makes new_species_value an absolute mass fraction; anything else, relative to hydrogen
      ! (legacy name: atmp)
      new_species_value_mode = ''

      ! The rotating star's shape: the relative tolerance on r0^3 of the equipotential radius iteration (its cube root that on r0 and eta2); not a weight
      ! (legacy name: acfpft)
      fpft_average_weight = 1.0d-36

      ! The timestep limits, slot by slot as the time_* controls (itime_* in state/control_slots.f90): time_core_min, time_dx_core_tot, time_dx_core_frac, time_dy_core_tot, time_dy_core_frac, time_dx_total, time_dx_shell, time_dt, time_dp, time_dr, time_dl, time_dy_shell, time_max_dt_frac, time_dy_total; used unless use_new_rate_variables, which takes the named controls instead
      ! (legacy name: atime)
      timestep_factors = 1.0d-3, 2.0d-2, 5.0d-1, 2.0d-2, 3.0d-1, 1.5d-3, 1.0d-1, 2.0d-2, 4.0d-2, 2.0d-2, 2.0d-2, 0.25d0, 1.5d0, 0.25d0

      ! Core overshoot extent in pressure scale heights
      ! (legacy name: alphac)
      overshoot_alpha_core = 0.0d0

      ! Envelope overshoot extent in pressure scale heights
      ! (legacy name: alphae)
      overshoot_alpha_envelope = 0.0d0

      ! Kawaler wind law: the index n (Jdot ~ Omega**(1+4n/3) ...); K97 takes m = n/3
      ! (legacy name: alfa)
      wind_law_index = 1.5d0

      ! Overshoot of intermediate convection zones (intermediate_overshoot_active), in pressure scale heights
      ! (legacy name: alpham)
      overshoot_alpha_min = 0.0d0

      ! Envelope generation: the atmosphere step size
      ! (legacy name: atmstp)
      atm_step_size = 0.5d0

      ! Burning network: absolute tolerance
      ! (legacy name: abstol)
      absolute_tolerance = 1.0d-5

      ! With overshoot_max_extent_flag: the core overshoot extent is capped at this fraction of the core radius
      ! (legacy name: betac)
      overshoot_beta_core = 0.15d0

      ! Burning network: abundances below this are treated as zero
      ! (legacy name: cmin)
      min_abundance = 1.0d-20

      ! Solar luminosity (erg/s)
      ! (legacy name: clsun)
      solar_luminosity_cgs = 3.8515d33

      ! The solar radius (cm) used for the tracks and the output
      ! (legacy name: crsun)
      solar_radius_cgs = 6.9598d10

      ! Solar mass (g), which converts Msun to grams everywhere (the rescaling, log g, the seismic scalings)
      solar_mass_cgs = 1.9891d33

      ! Newton's G (cgs). Negative (the default) keeps YREC's log10 G = -7.17571 (G = 6.6726e-8) bit for bit; a positive value (e.g. 6.6743d-8, CODATA 2018) replaces it
      G_cgs = -1.0d0

      ! Deep mixing: below 1, the composition step mixes every shell from the centre out to the mass envelope_logp_step times the star's (a mass fraction, whatever the name says); 1 or more is off
      ! (legacy name: dpenv)
      envelope_logP_step = 1.0d0

      ! Sub-timestep factor for rotation diffusion
      ! (legacy name: dtdif)
      diffusion_timestep_factor = 1.0d-2

      ! Timestep limit: the largest fractional change of omega per step
      ! (legacy name: dtwind)
      max_domega_global = 1.0d1

      ! Angular momentum transport: the convergence tolerance of the transport iterations
      ! (legacy name: djok)
      convergence_tolerance = 1.0d-4

      ! Gravitational settling: sub-timestep as a fraction of the timestep
      ! (legacy name: dt_gs)
      settling_timestep_fraction = 0.1d0

      ! Envelope integration: error tolerance
      ! (legacy name: enverr)
      env_error_tol = 3.0d-4

      ! The envelope integration's largest step (in log P)
      ! (legacy name: envmax)
      env_step_max = 5.0d-1

      ! Envelope integration: minimum step
      ! (legacy name: envmin)
      env_step_min = 1.0d-1

      ! Envelope integration: first step
      ! (legacy name: envbeg)
      env_step_begin = 1.0d-1

      ! Envelope generation: the envelope step size
      ! (legacy name: envstp)
      envelope_step_size = 0.5d0

      ! Debye-Hueckel correction: the lower degeneracy (eta) bound of its domain
      ! (legacy name: etadh0)
      debye_huckel_eta_min = -1.0d0

      ! Debye-Hueckel correction: the upper degeneracy (eta) bound of its domain
      ! (legacy name: etadh1)
      debye_huckel_eta_max = 1.0d0

      ! Henyey under-relaxation: each step starts with the correction factor |solver_underrelax_start| - solver_underrelax_increment; a positive value lets it grow each iteration
      ! (legacy name: fcorr0)
      solver_underrelax_start = 0.8d0

      ! Henyey under-relaxation: the correction factor grows by this each corrector pass, up to 1
      ! (legacy name: fcorri)
      solver_underrelax_increment = 0.1d0

      ! The constant factor of both wind laws (1 reproduces the solar angular momentum loss)
      ! (legacy name: fk)
      wind_law_constant = 1.0d0

      ! Scale of the angular momentum diffusion coefficients in the diffusion-advection transport
      ! (legacy name: fw)
      difad_velocity_scale = 1.0d0

      ! Ratio of the chemical mixing to the angular momentum diffusion coefficients (calibrated to Li depletion)
      ! (legacy name: fc)
      mixing_velocity_scale = 1.0d0

      ! Inert: read and used nowhere (the F77 code only echoed it, as COUPLING, in the run log's header)
      ! (legacy name: fo)
      coupling_factor = 1.0d0

      ! Scale of the Eddington-Sweet circulation velocity in the angular momentum transport
      ! (legacy name: fes)
      es_velocity_scale = 1.0d0

      ! With extend_core_inward: the factor by which the innermost mass is reduced
      ! (legacy name: fcore)
      core_mass_reduction_factor = 1.0d0

      ! Scale of the GSF and ABCD instability velocities in the angular momentum transport
      ! (legacy name: fgsf)
      gsf_velocity_scale = 1.0d0

      ! Scale of the secular shear instability velocity in the angular momentum transport
      ! (legacy name: fss)
      secular_shear_velocity_scale = 1.0d0

      ! Scale of the Eddington-Sweet circulation's chemical mixing relative to its angular momentum transport
      ! (legacy name: fesc)
      es_mixing_scale = 1.0d0

      ! Scale of the secular shear's chemical mixing relative to its angular momentum transport
      ! (legacy name: fssc)
      secular_shear_mixing_scale = 1.0d0

      ! Scale of the GSF instability's chemical mixing relative to its angular momentum transport
      ! (legacy name: fgsfc)
      gsf_mixing_scale = 1.0d0

      ! Rotational transport: the Solberg-Hoiland instability's velocity scale (0 = off; it can act only where the dynamical shear does; MESA D_SH_factor)
      solberg_hoiland_velocity_scale = 0.0d0

      ! Rotational mixing: the Solberg-Hoiland instability's mixing efficiency
      solberg_hoiland_mixing_scale = 1.0d0

      ! Gravitational settling: the factor on helium's settling coefficients
      ! (legacy name: fgry)
      settling_y_factor = 1.0d0

      ! Gravitational settling: the factor on the metals' settling coefficients (a Monte-Carlo run samples it)
      ! (legacy name: fgrz)
      settling_z_factor = 1.0d0

      ! Gravitational settling: solver tolerance
      ! (legacy name: grtol)
      settling_tolerance = 1.0d-8

      ! The Henyey thresholds: rows 1-4 the per-variable convergence (column 1) and correction-too-large (column 2) limits, row 5 the level-5 residual test
      ! (legacy name: htoler)
      solver_tolerances = 6.0d-5, 4.5d-5, 3.0d-5, 9.0d-5, 3.0d-5, 9.0d-1, 5.0d-1, 5.0d-1, 2.0d0, 2.5d-6

      ! The zoning tolerances, slot by slot as the tol_*/flag_* controls (ichi_* in state/control_slots.f90): tol_dm_min, tol_dm_max, flag_dx, flag_dz, tol_dx_max, tol_dz_max, tol_czbase_fine_width, tol_dp_env_max, tol_dl_max, tol_dp_czbase_max, tol_dp_core_max, flag_dw; used unless use_new_rate_variables, which takes the named controls instead
      ! (legacy name: hpttol)
      zoning_tolerances = 1.0d-8, 8.0d-2, 5.0d-2, 5.0d-2, 1.0d0, 1.0d0, 0.0d0, 5.0d-2, 2.0d-2, 5.0d-2, 5.0d-2, 1.0d-1

      ! The rotating star's shape: the most iterations of eta2 and r0 in turn
      ! (legacy name: itfp1)
      fpft_iter1 = 5

      ! The rotating star's shape: the most Newton steps of each r0 solve
      ! (legacy name: itfp2)
      fpft_iter2 = 20

      ! The Bulirsch-Stoer integrator (envelope and atmosphere): the number of stages, 1 to 11
      ! (legacy name: imax)
      max_stage_index = 11

      ! The passes of the structure-rotation iteration per step (each pass converges the structure, mixes the convection zones and updates the angular momentum and the shape); 1 without rotation
      ! (legacy name: itdif1)
      num_rotation_structure_iters = 1

      ! The most iterations of each angular momentum transport sub-step (1 to 16; the controls read rejects a rotating run outside that)
      ! (legacy name: itdif2)
      max_diffusion_iters = 10

      ! The stability condition of the GSF and ABCD instabilities (1 is recommended)
      ! (legacy name: igsf)
      gsf_inhibition_mode = 1

      ! The Coulomb logarithm of the settling coefficients (4, a constant 2.2, is recommended)
      ! (legacy name: ilambda)
      coulomb_log_choice = 1

      ! Surface boundary condition: 0 Eddington gray T(tau), 1 Krishna-Swamy T(tau), 2 Harvard-Smithsonian atmosphere, 3 Kurucz tables, 4 Allard tables, 5 Kurucz/Castelli tables
      ! (legacy name: kttau)
      atm_choice = 0

      ! The burning network solver's largest number of iterations
      ! (legacy name: kemmax)
      max_burn_iterations = 50

      ! Rotational mixing: scale the composition diffusion coefficient by the Zahn (1992) coupling factor (D_mix = D_omega f_Zahn) instead of the fixed efficiencies (mixing_velocity_scale and the per-mechanism mixing scales)
      ! (legacy name: lvfc)
      velocity_form_correction = .false.

      ! Treat meridional circulation as diffusion plus advection (Zahn) instead of diffusion (stops a rotating run: the path is commented out)
      ! (legacy name: ldifad)
      use_diffusion_advection_transport = .false.

      ! No angular momentum transport in the convective core
      ! (legacy name: lnoj)
      no_am_transport_in_core = .false.

      ! Use the new diffusion routines
      ! (legacy name: lnewdif)
      use_new_diffusion_routines = .false.

      ! Gravitational settling of helium (and hydrogen)
      ! (legacy name: ldify)
      diffuse_helium_active = .false.

      ! Gravitational settling of the metals (implies helium settling and the Thoul et al. routines)
      ! (legacy name: ldifz)
      use_diffusion_z = .false.

      ! Include Li/Be in gravitational settling
      ! (legacy name: ldifli)
      diffuse_lithium = .false.

      ! Compute solar neutrino fluxes
      ! (legacy name: lsnu)
      calc_neutrinos = .false.

      ! Apply the Debye-Hueckel correction to the simplified EOS
      ! (legacy name: ldh)
      use_debye_huckel_correction = .false.

      ! Set one species of the starting model (change_species_name) to new_species_value
      ! (legacy name: lnewcp)
      rescale_species_active = .false.

      ! Helium flash run: no rezoning, the starting model written to the .mod file for timestep cuts, and flash-specific solver handling
      ! (legacy name: lkuthe)
      helium_flash_active = .false.

      ! Enable convective-core overshoot
      ! (legacy name: lovstc)
      core_overshoot_active = .false.

      ! Overshoot below the surface convection zone, by overshoot_alpha_envelope pressure scale heights
      ! (legacy name: lovste)
      envelope_overshoot_active = .false.

      ! Overshoot at intermediate convection zones (neither the core nor the surface convection zone), by overshoot_alpha_min
      ! (legacy name: lovstm)
      intermediate_overshoot_active = .false.

      ! Cap the core overshoot extent at overshoot_beta_core times the core radius
      ! (legacy name: lovmax)
      overshoot_max_extent_flag = .false.

      ! Extended composition: also follow H2, Li6, Li7 and Be9 (15 species)
      ! (legacy name: lexcom)
      use_extended_composition = .false.

      ! Rotation: evolve the rotation curve and the angular momentum transport
      ! (legacy name: lrot)
      rotation_flag = .false.

      ! Force a fresh envelope-fit triangle at run start
      ! (legacy name: lnew0)
      new_triangle_init_flag = .false.

      ! Rotationally induced mixing and hydrodynamic angular momentum transport
      ! (legacy name: linstb)
      instability_transport_active = .false.

      ! Initialize solid-body rotation at omega = initial_omega
      ! (legacy name: lwnew)
      set_initial_omega = .false.

      ! Apply magnetic wind angular-momentum loss
      ! (legacy name: ljdot0)
      use_wind_torque = .true.

      ! Limit the timestep by the structure changes (time_dt, time_dp, time_dr, time_dl)
      ! (legacy name: lptime)
      use_structure_dt_limits = .true.

      ! The overshoot region below the surface convection zone is adiabatic: its radiative points take the adiabatic gradient
      ! (legacy name: ladov)
      adiabatic_overshoot_active = .false.

      ! Limit the timestep by the envelope-fit triangle
      ! (legacy name: ltrist)
      use_envelope_triangle_dt = .false.

      ! Inert: read and stored, used nowhere (the outer layers are built by stitched_model)
      ! (legacy name: lenvg)
      envelope_generation_flag = .false.

      ! Neutrino losses from Itoh et al. (1996)
      ! (legacy name: lnulos1)
      use_itoh_neutrino_loss = .false.

      ! Thoul et al. diffusion coefficients
      ! (legacy name: lthoul)
      use_thoul_diffusion = .false.

      ! Use the published fit to the Thoul et al. settling coefficients instead of the full solution (not recommended)
      ! (legacy name: lthoulfit)
      use_thoul_fit = .false.

      ! Use the OPAL 1995 EOS (a newer OPAL EOS selected wins)
      ! (legacy name: lopale)
      use_opal95_eos = .false.

      ! Use the MHD EOS
      ! (legacy name: lmhd)
      use_mhd_eos = .false.

      ! Add shells inward of the starting model's innermost shell
      ! (legacy name: lcore)
      extend_core_inward = .false.

      ! Semiconvection treatment (conflicts with core overshoot)
      ! (legacy name: lsemic)
      use_semiconvection = .false.

      ! Use stored structure changes for the next model's first guess
      ! (legacy name: lnews)
      improved_first_guess_flag = .false.

      ! With extend_core_inward: the number of points added inward (recomputed from core_mass_reduction_factor)
      ! (legacy name: mcore)
      num_core_shells_added = 0

      ! Henyey iteration limit, level 1 (fresh surface BC)
      ! (legacy name: niter1)
      max_iter_level1 = 2

      ! Henyey iteration limit, level 2
      ! (legacy name: niter2)
      max_iter_level2 = 20

      ! Henyey iteration limit, level 3
      ! (legacy name: niter3)
      max_iter_level3 = 2

      ! Henyey iteration limit, level 4 (high precision)
      ! (legacy name: niter4)
      max_iter_level4 = 0

      ! The Bulirsch-Stoer integrator (envelope and atmosphere): the extrapolation order, 2 to 7 and at most max_stage_index
      ! (legacy name: nuse)
      extrap_order = 7

      ! Settling: the largest number of iterations of the abundance-change solver
      ! (legacy name: niter_gs)
      settling_num_iterations = 10

      ! Opacity tables: tolerance for matching the model's metallicity to a table's
      ! (legacy name: optol)
      metal_fraction_match_tolerance = 1.0d-8

      ! Critical Reynolds number for the onset of the secular shear instability
      ! (legacy name: rcrit)
      critical_reynolds = 1.0d3

      ! The burning network solver's relative tolerance
      ! (legacy name: reltol)
      relative_tolerance = 1.0d-4

      ! The envelope integration stops when log(m/M) is within this fraction of senv (also the atmosphere integration's step tolerance)
      ! (legacy name: stolr0)
      tolerance_fraction = 1.0d-3

      ! log T cutoffs (5) below which burning groups are switched off
      ! (legacy name: tcut)
      nuclear_logT_cutoffs = 6.5d0, 6.5d0, 6.82d0, 7.7d0, 7.5d0

      ! log10 T above which the default EOS assumes full ionization
      ! (legacy name: tscut)
      saha_log10t_cutoff = 6.0d0

      ! The rezone keeps the outermost interior point hotter than this log10 T: cooler outer points are deleted
      ! (legacy name: tenv0)
      rezone_env_logT0 = 3.0d0

      ! The rezone adds a point outside the outermost interior point when that point is hotter than this log10 T (at the stored envelope state)
      ! (legacy name: tenv1)
      rezone_env_logT1 = 9.0d0

      ! Above this log10 T a convective point takes the adiabatic gradient without the mixing-length theory (deep convective cores)
      ! (legacy name: tgcut)
      gradient_logT_cutoff = 6.9d0

      ! Envelope-fit triangle: size in log Teff
      ! (legacy name: tridt)
      tri_delta_teffl = 1.0d-2

      ! Envelope-fit triangle: size in log L
      ! (legacy name: tridl)
      tri_delta_logl = 8.0d-2

      ! The LAOL 1989 interpolators extrapolate linearly within log10(laol_extrapolation_tolerance) of a table edge
      ! (legacy name: tollaol)
      laol_z_tolerance = 10.0d0

      ! The surface mixture's relative mass fractions, one per slot of state/composition_layout.f90 (Na, Al, Mg, Fe, Si, C, H, O, N, Ar, Ne, He; H and He are set from the envelope X and Z): the starting model's envelope number fractions and the EOS mixture are made from the ten metals'
      ! (legacy name: vnew)
      mixture_weights_seed = 0.001999d0, 0.003238d0, 0.037573d0, 0.071794d0, 0.040520d0, 0.173285d0, 0.000000d0, 0.482273d0, 0.053152d0, 0.005379d0, 0.098668d0, 0.000000d0

      ! Exponent alpha of the surface convection zone's rotation law omega ~ r^alpha (0 or above: solid body; -2 or below: constant specific angular momentum); also gives the omega of shells added at the surface and the specific angular momentum the wind removes
      ! (legacy name: walpcz)
      ! (also accepted: new_zone_omega_weight)
      cz_rotation_law_exponent = 0.0d0

      ! Initial rotation rate when set_initial_omega
      ! (legacy name: wnew)
      initial_omega = 0.0d0

      ! Threshold of the screening parameter below which nuclear rates use weak screening
      ! (legacy name: weakscreening)
      weak_screening_threshold = 0.03d0

      ! New abundance for change_species_name
      ! (legacy name: xnewcp)
      change_species_value = 1.3d1

      ! Settling stops (for the rest of the run card) once the central X falls below this
      ! (legacy name: xmin)
      hydrogen_diffusion_floor = 1.0d-3

      ! Settling's outer boundary moves inward to the first zone where Y exceeds this
      ! (legacy name: ymin)
      helium_diffusion_min = 1.0d-3

      ! log10 T below which only the molecular opacities are used
      ! (legacy name: tmolmin)
      molecular_opacity_logt_min = 4.0d0

      ! log10 T above which only the atomic opacities are used (a ramp joins the two)
      ! (legacy name: tmolmax)
      molecular_opacity_logt_max = 4.1d0

      ! Monte-Carlo multi-realization mode
      ! (legacy name: lmonte)
      monte_carlo_active = .false.

      ! First Monte-Carlo realization index
      ! (legacy name: imbeg)
      mc_run_start = 1

      ! Last Monte-Carlo realization index
      ! (legacy name: imend)
      mc_run_end = 1

      ! Use the SCV EOS where it is valid and the OPAL EOS is not
      ! (legacy name: lscv)
      use_scv_eos = .false.

      ! Disk locking: hold the surface rotation at disk_omega_rad_s until disk_locking_age_gyr
      ! (legacy name: ldisk)
      disk_locking_active = .false.

      ! Disk locking: the age (Gyr) up to which the surface rotation is held at disk_omega_rad_s (some older deck comments give it in yr, which the code never read)
      ! (legacy name: tdisk)
      disk_locking_age_gyr = 0.0d0

      ! Disk locking: the surface angular velocity (rad/s) held until disk_locking_age_gyr (some older deck comments call it a period in days, which the code never read)
      ! (legacy name: pdisk)
      disk_omega_rad_s = 7.2722d-6

      ! Saturation angular velocity of the wind law (rad/s); solar_omega_sat below 1000 overrides it in solar units
      ! (legacy name: wmax)
      wind_saturation_omega = 3.0d-4

      ! Force solid-body rotation (sets solid_body_mode_flag = 1)
      ! (legacy name: lsolid)
      force_solid_body_rotation = .false.

      ! Angular momentum coupling: 0 none, 1 solid body everywhere, 2 solid-body core with a decoupled convection zone, 3 solid-body core coupled at the base of the convection zone
      ! (legacy name: impjmod)
      solid_body_mode_flag = 0

      ! Mass change rate (Msun/yr; negative for loss) when use_mass_change is set
      ! (legacy name: dmdt0)
      mass_change = -1.0d-14

      ! Mass change: the timestep changes the surface convection zone's mass by at most this fraction
      ! (legacy name: fczdmdt)
      accretion_cz_fraction = 0.1d0

      ! Mass change: the timestep changes the star's mass by at most this fraction
      ! (legacy name: ftotdmdt)
      accretion_total_fraction = 1.0d-2

      ! Mass fractions of the accreted material (star%xa layout)
      ! (legacy name: compacc)
      accreted_composition = 0.71668d0, 0.265721d0, 0.01757d0, 2.9d-5, 3.013d-3, 3.385d-5, 9.346d-4, 0.0d0, 8.462d-3, 0.0d0, 1.696d-5, 0.0d0, 2.0d-9, 2.0d-9, 3.0d-11

      ! Reimers mass-loss efficiency eta
      ! (legacy name: creim)
      reimers_scaling_factor = -4.0d-13

      ! Enable Reimers red-giant mass loss
      ! (legacy name: lreimer)
      use_reimers_wind = .false.

      ! Mass change: a constant rate (mass_accretion_rate) or the Reimers wind; switched off for the run when the disk is exhausted
      ! (legacy name: lmdot)
      use_mass_change = .false.

      ! Use the OPAL 2001 EOS (the 2006 EOS, if also selected, wins)
      ! (legacy name: lopale01)
      use_opal2001_eos = .false.

      ! Use the conductive opacity tables (conductive_opacity_table_file)
      ! (legacy name: lcondopacp)
      use_conductive_opacity = .false.

      ! Use the OPAL 2006 EOS
      ! (legacy name: lopale06)
      use_opal2006_eos = .false.

      ! Use numerical derivatives of the EOS instead of analytic ones (much slower)
      ! (legacy name: lnumderiv)
      use_numerical_derivatives = .false.

      ! Allard atmosphere tables: [Fe/H]
      ! (legacy name: alatm_feh)
      allard_target_feh = 0d0

      ! Allard atmosphere tables: [alpha/Fe]
      ! (legacy name: alatm_alpha)
      allard_target_alpha = 0d0

      ! Allard atmosphere tables: the boundary at tau = 100 instead of the photosphere
      ! (legacy name: laltptau100)
      allard_use_tau100 = .false.

      ! Constant added diffusion coefficient (mixing)
      ! (legacy name: cstmixing)
      constant_mixing_coeff = 1.0d0

      ! Constant coefficient mimicking mixing to reduce settling
      ! (legacy name: cstdiffmix)
      constant_settling_reduction = 1.0d0

      ! Inert: the rotation-scaled solar wind is commented out (core/step/mass_change.f90); the controls read warns when it is set
      ! (legacy name: lsolwind)
      use_rotation_scaled_solar_wind = .false.

      ! Use the Matt et al. (2012) magnetized wind law (wind_law_name) instead of the Kawaler law
      ! (legacy name: lmwind)
      use_pmm_wind_law = .false.

      ! Matt wind law: scale the loss rate with the Rossby number (use with a saturation threshold)
      ! (legacy name: lrossby)
      scale_by_rossby_number = .true.

      ! Inert: read and used nowhere (the Matt law is use_pmm_wind_law); the controls read warns when it is set
      ! (legacy name: lpmm)
      use_pmm_wind = .false.

      ! Matt wind law: scale the field with the equipartition B (set by wind_law_name for K97 and V13)
      ! (legacy name: lbscale)
      scale_by_b_field = .false.

      ! Matt wind law: V13 (van Saders & Pinsonneault 2013), K97 (Krishnamurthi et al. 1997), or CUS (the pmm_exponent_* as given)
      ! (legacy name: awind)
      wind_law_name = 'K97'

      ! PMM wind law: exponent a (Lx/Lbol ~ omega**a); K97 and V13 set it
      ! (legacy name: pmma)
      pmm_exponent_a = 2.0d0

      ! PMM wind law: exponent b, with Bmag ~ (omega R**c)**b; K97 and V13 set it
      ! (legacy name: pmmb)
      pmm_exponent_b = 1.0d0

      ! PMM wind law: exponent c, with Bmag ~ (omega R**c)**b; K97 and V13 set it
      ! (legacy name: pmmc)
      pmm_exponent_c = 2.0d0

      ! Matt wind law: exponent d of the convective turnover time in Bmag (CUS only; K97 and V13 set it)
      ! (legacy name: pmmd)
      pmm_exponent_d = 0.0d0

      ! Matt wind law: exponent m of the torque (CUS only; K97 and V13 set it)
      ! (legacy name: pmmm)
      pmm_exponent_m = 0.5d0

      ! Matt wind law: the solar wind torque (cgs), the zero point of the loss rate (adjust with wind_law_constant)
      ! (legacy name: pmmjd)
      pmm_norm_jdot = 1.32d30

      ! Matt wind law: the solar mass-loss rate (g/s), its zero point
      ! (legacy name: pmmmd)
      pmm_norm_mdot = 1.27d12

      ! Inert: read and used nowhere (the saturation is wind_saturation_omega or solar_omega_sat); the controls read warns when it is set
      ! (legacy name: pmmwmax)
      pmm_omega_sat = 0

      ! Matt wind law: log10 of the solar photospheric pressure (dyn/cm^2), the zero point of the field strength
      ! (legacy name: pmmsolp)
      pmm_solar_pressure = 4.9304d0

      ! Matt wind law: the solar angular velocity (rad/s), the zero point of the torque
      ! (legacy name: pmmsolw)
      pmm_solar_omega = 2.836d-6

      ! Matt wind law: the solar convective turnover time (s), the zero point of the Rossby number
      ! (legacy name: pmmsoltau)
      pmm_solar_turnover_timescale = 9.4805d5

      ! Add a constant background diffusion (constant_background_diffusion_coeff) to the angular momentum transport
      ! (legacy name: lcodm)
      use_constant_background_diffusion = .false.

      ! Constant background diffusion coefficient for angular momentum (cm^2/s)
      ! (legacy name: codm)
      constant_background_diffusion_coeff = 2.5d4

      ! The wind's saturation omega in units of the solar omega (pmm_solar_omega); below 1000 it overrides wind_saturation_omega
      ! (legacy name: wmax_sun)
      solar_omega_sat = 1000.0d0

      ! The Li6 burning cross section (keV b): with scale_li6_rate, li6_rate_scale is this over li6_reference_xs (5.5e3)
      ! (legacy name: xsli6)
      li6_rate_value = 5.5d3

      ! The Li7 burning cross section (keV b): with scale_li7_rate, li7_rate_scale is this over li7_reference_xs (52)
      ! (legacy name: xsli7)
      li7_rate_value = 5.2d1

      ! The Be9(p,g) cross section (keV b): with scale_be9_rate1, be9_pg_rate_scale is this over be9_pg_reference_xs (1.1)
      ! (legacy name: xsbe91)
      be9_rate_value1 = 1.1d0

      ! The Be9(p,d) cross section (keV b): with scale_be9_rate2, be9_pd_rate_scale is this over be9_pd_reference_xs (1.5e4)
      ! (legacy name: xsbe92)
      be9_rate_value2 = 1.5d4

      ! The Be9(p,a) cross section (keV b): with scale_be9_rate3, be9_palpha_rate_scale is this over be9_palpha_reference_xs (1.5e4)
      ! (legacy name: xsbe93)
      be9_rate_value3 = 1.5d4

      ! Take li6_rate_scale from the cross section li6_rate_value
      ! (legacy name: lxli6)
      scale_li6_rate = .false.

      ! Take li7_rate_scale from the cross section li7_rate_value
      ! (legacy name: lxli7)
      scale_li7_rate = .false.

      ! Take be9_pg_rate_scale from the cross section be9_rate_value1
      ! (legacy name: lxbe91)
      scale_be9_rate1 = .false.

      ! Take be9_pd_rate_scale from the cross section be9_rate_value2
      ! (legacy name: lxbe92)
      scale_be9_rate2 = .false.

      ! Take be9_palpha_rate_scale from the cross section be9_rate_value3
      ! (legacy name: lxbe93)
      scale_be9_rate3 = .false.

      ! Li6 burning rate scale (scale_li6_rate with li6_rate_value overrides it)
      ! (legacy name: sli6)
      li6_rate_scale = 1.0d0

      ! Li7 burning rate scale (scale_li7_rate with li7_rate_value overrides it)
      ! (legacy name: sli7)
      li7_rate_scale = 1.0d0

      ! Scale of the Be9(p,g) rate (scale_be9_rate1 with be9_rate_value1 overrides it)
      ! (legacy name: sbe91)
      be9_pg_rate_scale = 1.0d0

      ! Scale of the Be9(p,d) rate (scale_be9_rate2 with be9_rate_value2 overrides it)
      ! (legacy name: sbe92)
      be9_pd_rate_scale = 1.0d0

      ! Scale of the Be9(p,a) rate (scale_be9_rate3 with be9_rate_value3 overrides it)
      ! (legacy name: sbe93)
      be9_palpha_rate_scale = 1.0d0

      ! Take the cross sections from the s0_* controls (Adelberger et al. 2011 defaults) instead of the ratios to Bahcall & Ulrich (1988)
      ! (legacy name: lnewnuc)
      use_new_nuclear_rates = .false.

      ! Starspots: the filling factor
      ! (legacy name: spotf)
      spot_filling_factor = 0.00d0

      ! Starspots: the spot temperature contrast (with spot_filling_factor > 0; 0.85 is typical of sunspots)
      ! (legacy name: spotx)
      spot_temp_contrast = 1.00d0

      ! Starspots: decrease the spot contrast with depth, at constant B
      ! (legacy name: lsdepth)
      spot_depth_varies = .false.

      ! S-factor of p+p (keV b), used with use_new_nuclear_rates
      ! (legacy name: s0_1_1)
      s0_pp = 4.01d-22

      ! S-factor of He3+He3 (keV b), used with use_new_nuclear_rates
      ! (legacy name: s0_3_3)
      s0_he3he3 = 5.21d3

      ! S-factor of He3+He4 (keV b), used with use_new_nuclear_rates
      ! (legacy name: s0_3_4)
      s0_he3he4 = 5.6d-1

      ! S-factor of p+C12 (keV b), used with use_new_nuclear_rates
      ! (legacy name: s0_1_12)
      s0_p_c12 = 1.34d0

      ! S-factor of p+C13 (keV b), used with use_new_nuclear_rates
      ! (legacy name: s0_1_13)
      s0_p_c13 = 7.6d0

      ! S0 of N14(p,g)O15 (keV b), with use_new_nuclear_rates
      ! (legacy name: s0_1_14)
      s0_p_n14 = 1.66d0

      ! S0 of O16(p,g)F17 (keV b), with use_new_nuclear_rates
      ! (legacy name: s0_1_16)
      s0_p_o16 = 1.06d1

      ! The pep rate relative to pp, with use_new_nuclear_rates
      s0_pep = 3.5734d-6

      ! The constant of the linear term of Be7 electron capture, with use_new_nuclear_rates
      ! (legacy name: s0_1_be7e)
      s0_be7_electron = 1.7709d-10

      ! S0 of Be7(p,g)B8 (keV b), with use_new_nuclear_rates
      ! (legacy name: s0_1_be7p)
      s0_be7_p = 0.0208d0

      ! S0 of He3(p,e+ nu)He4 (keV b), with use_new_nuclear_rates
      s0_hep = 8.6d-20

      ! S0 of N15(p,a)C12 (keV b), which sets the N15 + p branching
      ! (legacy name: s0_1_15_c12alp)
      s0_n15_p_c12_branch = 7.3d4

      ! S0 of N15(p,g)O16 (keV b), which sets the N15 + p branching
      ! (legacy name: s0_1_15_o16)
      s0_n15_p_o16_branch = 3.6d1

      ! dS/dE of H1(p,e+ nu)H2 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_1_1)
      s0p_pp = 4.49d-24

      ! dS/dE of He3(He3,2p)He4 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_3_3)
      s0p_he3he3 = -4.9d0

      ! dS/dE of He3(a,g)Be7 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_3_4)
      s0p_he3he4 = -3.6d-4

      ! dS/dE of C12(p,g)N13 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_1_12)
      s0p_p_c12 = 2.6d-3

      ! dS/dE of C13(p,g)N14 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_1_13)
      s0p_p_c13 = -7.83d-3

      ! dS/dE of N14(p,g)O15 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_1_14)
      s0p_p_n14 = -3.3d-3

      ! dS/dE of O16(p,g)F17 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_1_16)
      s0p_p_o16 = -5.4d-2

      ! d2S/dE2 of C12(p,g)N13 (b/keV), with use_new_nuclear_rates
      ! (legacy name: s0pp_1_12)
      s0pp_p_c12 = 8.3d-5

      ! d2S/dE2 of C13(p,g)N14 (b/keV), with use_new_nuclear_rates
      ! (legacy name: s0pp_1_13)
      s0pp_p_c13 = 7.29d-4

      ! d2S/dE2 of O16(p,g)F17 (b/keV), with use_new_nuclear_rates
      ! (legacy name: s0pp_1_16)
      s0pp_p_o16 = 0.0d0

      ! dS/dE of Be7(p,g)B8 (b), with use_new_nuclear_rates
      ! (legacy name: s0p_1_be7p)
      s0p_be7_p = -3.12d-5

      ! d2S/dE2 of Be7(p,g)B8 (b/keV), with use_new_nuclear_rates
      ! (legacy name: s0pp_1_be7p)
      s0pp_be7_p = -2.288d-7

      ! Zoning: an X jump between shells larger than this flags a shell
      flag_dx = 0.05d0

      ! Zoning: the largest log-omega spacing (rotating models)
      flag_dw = 0.10d0

      ! Zoning: a Z jump between shells larger than this flags a shell
      flag_dz = 0.05d0

      ! With use_new_rate_variables: limit the timestep by the structure changes time_dt..time_dl (switched off once nuclear burning dominates)
      lstruct_time = .false.

      ! With use_new_rate_variables: the smallest central X or Y for the core-burning timestep criteria
      time_core_min = 1.0d-3

      ! With use_new_rate_variables: the largest change of L at any point per step (pre-main sequence)
      time_dl = 2.0d-2

      ! With use_new_rate_variables: the largest change of P at any point per step (pre-main sequence)
      time_dp = 4.0d-2

      ! With use_new_rate_variables: the largest change of r at any point per step (pre-main sequence)
      time_dr = 2.0d-2

      ! With use_new_rate_variables: the largest change of T at any point per step (pre-main sequence)
      time_dt = 2.0d-2

      ! With use_new_rate_variables: the largest change of omega per step
      time_dw_global = 8.0d-2

      ! With use_new_rate_variables: the largest change of omega per rotational-mixing sub-step
      time_dw_mix = 8.0d-2

      ! With use_new_rate_variables: the largest fraction of the central X burned per step
      time_dx_core_frac = 0.5d0

      ! With use_new_rate_variables: the largest change of the central X per step
      time_dx_core_tot = 2.0d-2

      ! With use_new_rate_variables: the largest fraction of X burned in the shell per step
      time_dx_shell = 0.1d0

      ! With use_new_rate_variables: the largest mass of hydrogen burned per step (Msun)
      time_dx_total = 1.5d-3

      ! With use_new_rate_variables: the largest fraction of the central Y burned per step
      time_dy_core_frac = 0.5d0

      ! With use_new_rate_variables: the largest change of the central Y per step
      time_dy_core_tot = 2.0d-2

      ! With use_new_rate_variables: the largest fraction of Y burned in the shell per step
      time_dy_shell = 0.1d0

      ! With use_new_rate_variables: the largest mass of helium burned per step (Msun)
      time_dy_total = 1.5d-3

      ! With use_new_rate_variables: the width in log P of the finely zoned region at the base of the convection zone
      tol_czbase_fine_width = 0.0d0

      ! With use_new_rate_variables: the largest spacing in L/L_surface between points
      tol_dl_max = 0.02d0

      ! With use_new_rate_variables: the largest spacing in log m between points
      tol_dm_max = 0.08d0

      ! With use_new_rate_variables: the smallest spacing in log m between points
      tol_dm_min = 1.0d-8

      ! With use_new_rate_variables: the largest spacing in log P below the surface convection zone
      tol_dp_core_max = 0.05d0

      ! With use_new_rate_variables: the largest spacing in log P near the base of the surface convection zone
      tol_dp_czbase_max = 0.05d0

      ! With use_new_rate_variables: the largest spacing in log P in the surface convection zone
      tol_dp_env_max = 0.05d0

      ! With use_new_rate_variables: the largest spacing in X between points (usually off)
      tol_dx_max = 1.0d0

      ! With use_new_rate_variables: the largest spacing in Z between points (usually off)
      tol_dz_max = 1.0d0

      ! With use_new_rate_variables: the largest factor by which the timestep changes from one model to the next
      time_max_dt_frac = 1.5d0

      ! Take the zoning and timestep tolerances from the named tol_*, flag_* and time_* controls (and use_structure_time_limits) instead of zoning_tolerances and timestep_factors; nothing to do with reaction rates
      ! (legacy name: lnewvars)
      use_new_rate_variables = .false.

      ! Integrate the full envelope (false: the atmosphere to the photosphere only)
      ! (legacy name: lcalcenv)
      calc_envelope_flag = .true.

      ! Profile/pulse file name prefix: <prefix><N>.data[.GYRE/.FGONG/.GSM] in the output directory
      profile_data_prefix = 'profile'

      ! The history file's name, in the output directory
      star_history_name = 'history.data'

      ! Print the compact per-model progress line (terminal + run log) every N models; 0 = off; the final model always prints
      terminal_interval = 50

      ! Solar nu_max [uHz] for the scaling relation (Huber et al. 2011)
      nu_max_sun = 3090.0d0

      ! Solar delta_nu [uHz] for the mean-density scaling relation (Huber et al. 2011)
      delta_nu_sun = 135.1d0

      ! Solar effective temperature [K] for the nu_max scaling relation (IAU nominal value)
      Teff_sun = 5772.0d0

      ! Write the solver forensics to the run log (Henyey iteration trace, envelope and atmosphere integration statistics, triangle and rezoning bookkeeping); the read installs it as run_messages' gate, solver_diagnostics(), which the run asks
      report_solver_diagnostics = .false.

      ! Write profile{N}.data every N converged models (0 = off); the history's profile_number column maps models to profiles
      profile_interval = 50

      ! The pulsation files' format (GYRE text, FGONG, or GSM = GYRE HDF5 [needs make USE_HDF5=1]), written beside each profile as profile{N}.data.{format}
      pulse_format = 'GYRE'

      ! Write the profile{N}.data files (every profile_interval models)
      write_profile_flag = .false.

      ! Write a pulsation file (pulse_format) with each profile
      write_pulse_flag = .false.

      ! Diagnostic: write the per-zone solar neutrino production table (fluxes per shell, normalized profiles, Bahcall-Pinsonneault layout) to the run log at the start of each run
      compute_neutrino_fluxes = .false.

/

! Unused legacy controls (accepted by the legacy reader only,
! referenced nowhere in the code; dropped from the new format):
!   fmu, ies, imu
! Legacy-reader only, dropped from the new format: sstandard, the
! The cross sections as ratios to Bahcall & Ulrich (1988), one per slot of the legacy SSTANDARD array, used without use_new_nuclear_rates
